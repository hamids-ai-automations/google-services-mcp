# ---------------------------------------------------------------------------
# Google Services MCP - environment template
# Copy to .env and fill in. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Transport: stdio (local agents) or streamable-http (remote, requires auth)
GSMCP_TRANSPORT=stdio
GSMCP_HOST=127.0.0.1
GSMCP_PORT=8765
GSMCP_HTTP_PATH=/mcp

# Optional path to a YAML config file (defaults to ./config/config.yaml)
# GSMCP_CONFIG_FILE=./config/config.yaml

# --- OAuth (user credentials) ---------------------------------------------
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
GSMCP_OAUTH_CLIENT_SECRETS_FILE=./secrets/client_secrets.json
# Where the refresh/access token is cached (created by `google-services-mcp auth login`).
GSMCP_OAUTH_TOKEN_FILE=./secrets/token.json

# --- Permission mode -------------------------------------------------------
# read_only | read_write | restricted | custom
GSMCP_PERMISSIONS_MODE=read_only
# Comma separated allow-list, only used when mode=restricted
GSMCP_ALLOWED_TOOLS=
# Hard guard for outbound email. Must be true AND gmail.send policy enabled.
GSMCP_ALLOW_EMAIL_SEND=false

# --- Audit -----------------------------------------------------------------
GSMCP_AUDIT_ENABLED=true
GSMCP_AUDIT_PATH=./logs/audit.jsonl

# --- Limits ----------------------------------------------------------------
GSMCP_MAX_PAGE_SIZE=100
GSMCP_MAX_RESULT_CHARS=20000
GSMCP_REQUESTS_PER_MINUTE=120
GSMCP_REQUEST_TIMEOUT_SECONDS=30
